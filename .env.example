SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_sua-chave-publica
SUPABASE_SECRET_KEY=sb_secret_sua-chave-secreta-apenas-no-servidor
SUPABASE_JWKS_URL=https://seu-projeto.supabase.co/auth/v1/.well-known/jwks.json
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Shared rate limits use Supabase; apply 20261006100000_shared_rate_limit.sql before deployment.

# Server-only settings for optional Web Push and the reminder scheduler.
# See docs/ativacao-fluxo-cuidado.md for activation and migration order.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
CRON_SECRET=

# Stripe sandbox only. Live keys are rejected; no public Stripe key is needed.
# See docs/stripe-sandbox.md. Keep secrets exclusively on the server.
STRIPE_SANDBOX_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
